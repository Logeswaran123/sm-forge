# Copy to .env and adjust. Unset values fall back to the defaults shown.

# GPU index the worker runs on
DEVICE_INDEX=0

# Seconds before a worker request is abandoned and the worker restarted
WORKER_TIMEOUT=600

# Reference outputs and worker logs
CACHE_DIR=.smforge

# Device profiles written by `smforge device --save`
HARDWARE_DIR=hardware

# Timing
BENCH_WARMUP=100
BENCH_ITERS=200
BENCH_ROUNDS=10
BENCH_FLUSH_MB=256
# Speedups inside this band are reported as parity
BENCHMARK_MIN_EFFECT=0.02

# Correctness. Unset means: spec value, else the default for the variant's dtype.
# CORRECTNESS_RTOL=1e-2
# CORRECTNESS_ATOL=1e-2
CORRECTNESS_DRAWS=2
